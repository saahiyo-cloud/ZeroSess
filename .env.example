# Get API_ID + API_HASH: https://my.telegram.org -> API development tools
# Get BOT_TOKEN: https://t.me/BotFather -> /newbot
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional
OWNER_ID=123456789          # your Telegram user ID (/id in bot) — for /stats
LOG_CHANNEL=               # e.g. -100123... (only non-PII startup logs if set)
MUST_JOIN=                 # e.g. @yourchannel or https://t.me/yourchannel (leave empty to disable)
SUPPORT_CHAT=@yoursupport  # shown in /about
SESSION_TIMEOUT=300        # seconds per step (phone/otp/password)
RATE_LIMIT_COUNT=3         # max generations per window
RATE_LIMIT_WINDOW=3600     # window seconds (1h)
AUTO_DELETE_SECONDS=300    # auto-delete session message after this
